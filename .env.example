# Telegram is optional. Never commit real values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
# Use * to explicitly allow every chat; an empty value disables the bot.
# TELEGRAM_ALLOWED_CHAT_IDS=*

# MCP: connect to an already running control plane. Comment out to run an
# isolated in-process home instead (or pass --local).
# POWER_GUARDIAN_API_URL=http://127.0.0.1:8787

# Ujin credentials stay server-side; accepts доступы.json or the supplied ZIP.
# UJIN_CREDENTIALS_FILE="C:/path/to/quattrocold.zip"
# UJIN_BINDINGS_FILE="C:/path/to/ujin-bindings.json"
UJIN_PANEL_URL=https://signal-panel.duckdns.org
# off (default), read (monitor), sync (publish readings + consume API tasks).
UJIN_MODE=off
