{
  "mcpServers": {
    "shadcn": {
      "command": "npx",
      "args": ["-y", "shadcn@latest", "mcp"]
    },
    "power-guardian": {
      "command": ".venv-mcp/Scripts/python.exe",
      "args": ["app/run.py", "--mcp"],
      "env": {
        "POWER_GUARDIAN_API_URL": "http://127.0.0.1:8787"
      }
    }
  }
}
